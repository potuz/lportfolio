# lportfolio configuration template.
# Copy to `.env` and fill in. The real `.env` is gitignored.

# -- Tracked addresses -------------------------------------------------------
# Comma-separated list of `alias=0xaddress` pairs.
# Aliases are free-form labels used in CLI output and `--address` flags.
LPORTFOLIO_ADDRESSES=hot=0x0000000000000000000000000000000000000000,cold=0x0000000000000000000000000000000000000001

# -- Chain RPC endpoints -----------------------------------------------------
# One URL per chain you want to track. Leave a chain blank to skip it.
# Reads that only need current state (balances, contract views) go here;
# historical reads use the explorer API below.
LPORTFOLIO_RPC_MAINNET=https://eth.llamarpc.com
LPORTFOLIO_RPC_ARBITRUM=
LPORTFOLIO_RPC_OPTIMISM=
LPORTFOLIO_RPC_BASE=

# -- Explorer (Etherscan v2 unified) -----------------------------------------
# A single API key works for mainnet + most L2s via the v2 unified endpoint.
LPORTFOLIO_ETHERSCAN_API_KEY=

# -- Beacon chain ------------------------------------------------------------
# Local beacon node URL (standard Beacon API, e.g. http://localhost:5052).
# Empty/unset → `holdings` skips the staking section.
LPORTFOLIO_BEACON_URL=
# Comma-separated validator indices you control. Required for staking when
# BEACON_URL is set.
LPORTFOLIO_VALIDATOR_INDICES=

# -- Gnosis Safes ------------------------------------------------------------
# Comma-separated list of aliases (from LPORTFOLIO_ADDRESSES) that are Safes.
# These get a "(Safe)" badge in the holdings table; balances are read with the
# same eth_getBalance / balanceOf calls as for EOAs.
LPORTFOLIO_SAFES=

# -- ERC-20 token whitelist --------------------------------------------------
# Comma-separated logical token names to track in `holdings`. Leave empty
# to only show native ETH. Currently supported: USDC, USDT, ARB, DAI.
LPORTFOLIO_TOKEN_WHITELIST=

# -- Lido CSM ----------------------------------------------------------------
# Comma-separated list of node operator IDs you control on Lido CSM.
# Leave empty if you have no CSM bond.
LPORTFOLIO_LIDO_CSM_OPERATOR_IDS=

# -- Logging -----------------------------------------------------------------
# Standard tracing-subscriber filter. Examples: `info`, `lportfolio=debug`.
RUST_LOG=info
