# lportfolio configuration template.
# Copy to `.env` and fill in. The real `.env` is gitignored.

# -- Tracked addresses -------------------------------------------------------
# Comma-separated list of `alias=0xaddress` pairs.
# Aliases are free-form labels used in CLI output and `--address` flags.
LPORTFOLIO_ADDRESSES=hot=0x0000000000000000000000000000000000000000,cold=0x0000000000000000000000000000000000000001

# -- Chain RPC endpoints -----------------------------------------------------
# One URL per chain you want to track. Leave a chain blank to skip it.
# Reads that only need current state (balances, contract views) go here;
# historical reads use the explorer API below.
LPORTFOLIO_RPC_MAINNET=https://eth.llamarpc.com
LPORTFOLIO_RPC_ARBITRUM=
LPORTFOLIO_RPC_OPTIMISM=
LPORTFOLIO_RPC_BASE=

# -- Explorer (Etherscan v2 unified) -----------------------------------------
# A single API key works for mainnet + most L2s via the v2 unified endpoint.
LPORTFOLIO_ETHERSCAN_API_KEY=

# -- Logging -----------------------------------------------------------------
# Standard tracing-subscriber filter. Examples: `info`, `lportfolio=debug`.
RUST_LOG=info
